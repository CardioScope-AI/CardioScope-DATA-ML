{
    "model": "RandomForestClassifier",
    "n_estimators": 100,
    "random_state": 42,
    "dataset": "Cleveland",
    "features": [
        "age",
        "sex",
        "cp",
        "trestbps",
        "chol",
        "fbs",
        "restecg",
        "thalach",
        "exang",
        "oldpeak",
        "slope",
        "ca",
        "thal"
    ],
    "target": {
        "name": "num",
        "definition": "0 si num vaut 0 (absence de pathologie), 1 si num est supérieur à 0 (présence de pathologie)"
    },
    "train_samples": 242,
    "test_samples": 61,
    "cv_folds": 5,
    "cv_metrics": {
        "accuracy": 0.8181,
        "precision": 0.8173,
        "recall": 0.7826,
        "f1": 0.7948,
        "roc_auc": 0.8967
    },
    "python_version": "3.13.7",
    "numpy_version": "2.2.6",
    "scipy_version": "1.15.3",
    "sklearn_version": "1.6.1",
    "joblib_version": "1.4.2"
}